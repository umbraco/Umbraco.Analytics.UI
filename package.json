{
  "name": "umbraco-analytics-ui",
  "private": true,
  "description": "Runs the client app build from the repo root (used by the shared Umbraco.Build pipeline)",
  "scripts": {
    "ci:install-client": "cd ./src/Umbraco.Analytics.UI/Client && npm ci --no-fund --no-audit --prefer-offline",
    "ci:build-client": "cd ./src/Umbraco.Analytics.UI/Client && npm run build:app && npm run check:size",
    "ci:pack-client": "cd ./src/Umbraco.Analytics.UI/Client && npm run build-and-pack:api",
    "ci:lint-client": "cd ./src/Umbraco.Analytics.UI/Client && npm run lint",
    "ci:test-client": "cd ./src/Umbraco.Analytics.UI/Client && npm run test:ci",
    "ci:test-perf-client": "cd ./src/Umbraco.Analytics.UI/Client && npm run test:perf",
    "ci:storybook-client": "cd ./src/Umbraco.Analytics.UI/Client && npm run storybook:build",
    "install-client": "cd ./src/Umbraco.Analytics.UI/Client && npm install",
    "build-client": "cd ./src/Umbraco.Analytics.UI/Client && npm run build",
    "watch-client": "cd ./src/Umbraco.Analytics.UI/Client && npm run watch",
    "test-client": "cd ./src/Umbraco.Analytics.UI/Client && npm test",
    "storybook": "cd ./src/Umbraco.Analytics.UI/Client && npm run storybook"
  }
}
