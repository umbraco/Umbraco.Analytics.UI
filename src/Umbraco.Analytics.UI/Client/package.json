{
  "name": "@umbraco/analytics-ui",
  "version": "19.0.0-alpha.1",
  "type": "module",
  "imports": {
    "#platform/lit": "./src/platform/umbraco/lit.ts",
    "#platform/uui": "./src/platform/umbraco/uui.ts",
    "#platform/chart": "./src/platform/umbraco/chart.ts",
    "#platform/base-element": "./src/platform/umbraco/base-element.ts",
    "#platform/context": "./src/platform/umbraco/context.ts",
    "#platform/date-range-opener": "./src/platform/umbraco/date-range-opener.ts"
  },
  "types": "./types/umbraco-analytics-ui-public.d.ts",
  "exports": {
    ".": {
      "types": "./types/umbraco-analytics-ui-public.d.ts"
    },
    "./external/chart.js": {
      "types": "./types/external/chart.js/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "external/chart.js": [
        "types/external/chart.js/index.d.ts"
      ]
    }
  },
  "files": [
    "types/umbraco-analytics-ui-public.d.ts",
    "types/external/chart.js/index.d.ts",
    "types/external/chart.js/look.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=24.13",
    "npm": ">=11"
  },
  "author": {
    "name": "Umbraco A/S",
    "url": "https://umbraco.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:api && npm run build:app",
    "build:app": "tsc -p tsconfig.app.json && tsc -p tsconfig.core.json && vite build && vite build -c vite.config.core.ts",
    "build:api": "tsc -p tsconfig.api.json && api-extractor run -c api-extractor.json --typescript-compiler-folder ./node_modules/typescript --local && api-extractor run -c api-extractor.external-chart.json --typescript-compiler-folder ./node_modules/typescript --local && tsc -p tsconfig.core-api.json && api-extractor run -c api-extractor.core.json --typescript-compiler-folder ./node_modules/typescript --local",
    "check:size": "node ./devops/check-bundle-size.js",
    "check:api": "tsc -p tsconfig.api.json && api-extractor run -c api-extractor.json --typescript-compiler-folder ./node_modules/typescript && api-extractor run -c api-extractor.external-chart.json --typescript-compiler-folder ./node_modules/typescript && tsc -p tsconfig.core-api.json && api-extractor run -c api-extractor.core.json --typescript-compiler-folder ./node_modules/typescript",
    "prepack:api": "node ./devops/publish/sync-package-version.js && node ./devops/publish/cleanse-pkg.js && npx mkdirp ./artifacts",
    "pack:api": "npm pack --pack-destination ./artifacts",
    "postpack:api": "node ./devops/publish/copy-package-to-output-dir.js",
    "build-and-pack:api": "npm run build:api && npm run pack:api",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src .storybook",
    "analyze": "web-component-analyzer \"src/**/*.element.ts\" --outFile custom-elements.json",
    "storybook": "npm run analyze && storybook dev -p 6006",
    "storybook:build": "npm run analyze && storybook build",
    "test:screenshots": "sh ./devops/screenshots/run-in-container.sh",
    "test:screenshots:update": "sh ./devops/screenshots/run-in-container.sh --update",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=./test-results/junit.xml"
  },
  "peerDependencies": {
    "@umbraco-cms/backoffice": "^19.0.0-beta1"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.55.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/web-components-vite": "^10.6.6",
    "@umbraco-cms/backoffice": "19.0.0-beta1",
    "@umbraco-ui/uui": "^2.1.1",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.3",
    "eslint-plugin-storybook": "^10.6.6",
    "eslint-plugin-wc": "^3.1.0",
    "lit": "^3.3.3",
    "mkdirp": "^3.0.1",
    "playwright": "^1.64.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.5",
    "vitest-browser-lit": "^1.0.1",
    "web-component-analyzer": "^2.0.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "js-yaml": "^4.3.2"
  }
}
