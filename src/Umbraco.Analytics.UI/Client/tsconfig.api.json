{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./types",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly" : true
  },
  "include": [ "src/**/*.ts" ],
  "exclude": [ "src/**/*.test.ts", "src/**/*.story.ts", "src/internal/test/**", "src/internal/story/**" ]
}
