<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://www.nuget.org/api/v2/" />
    <add key="Umbraco Prereleases" value="https://www.myget.org/F/umbracoprereleases/api/v3/index.json" />
    <add key="Umbraco Nightly" value="https://www.myget.org/F/umbraconightly/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- CMS packages come from nuget.org only. A CMS prerelease can be on MyGet too with different contents
         (MyGet allows overwrites), and restoring from either would break the lock file's hash check.
         Add the MyGet feeds to Umbraco.Cms.* here when building against a CMS nightly. -->
    <packageSource key="nuget.org">
      <package pattern="Umbraco.Cms.*" />
      <package pattern="Umbraco.*" />
      <package pattern="*" />
    </packageSource>
    <packageSource key="Umbraco Prereleases">
      <package pattern="Umbraco.*" />
    </packageSource>
    <packageSource key="Umbraco Nightly">
      <package pattern="Umbraco.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>